name: "Tests"
on: {
  push: {
    branches: "master"
  }
  pull_request: {
    branches: "master"
  }
}
jobs: {
  test: {
    runs-on: "ubuntu-latest"
    strategy: {
      matrix: {
        python-version: "3.11"
        python-version: "3.12"
        python-version: "3.13"
        python-version: "3.14"
      }
    }
    steps: {
      uses: "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0"
    }
    steps: {
      uses: "actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1"
      with: {
        python-version: "${{ matrix.python-version }}"
      }
    }
    steps: {
      run: "pip install -e .[dev]"
    }
    steps: {
      run: "ruff check ."
    }
    steps: {
      run: "pytest -q"
    }
  }
  typecheck: {
    runs-on: "ubuntu-latest"
    steps: {
      uses: "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0"
    }
    steps: {
      uses: "actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1"
      with: {
        python-version: "3.12"
      }
    }
    steps: {
      run: "pip install -e .[dev]"
    }
    steps: {
      run: "mypy --strict omnist"
    }
  }
}