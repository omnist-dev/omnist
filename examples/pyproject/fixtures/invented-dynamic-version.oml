build-system: {
  requires: "flit_core>=3.4"
  build-backend: "flit_core.buildapi"
}
project: {
  name: "widget-toolkit"
  description: "A small synthetic example, not a real package."
  readme: "README.md"
  requires-python: ">=3.10"
  license: "MIT"
  dynamic: "version"
  optional-dependencies: {
    test: "pytest"
  }
}
tool: {
  flit: {
    module: {
      name: "widget_toolkit"
    }
  }
}